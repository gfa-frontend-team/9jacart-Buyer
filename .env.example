# App Configuration
VITE_APP_NAME=9jaCart
VITE_APP_URL=http://localhost:5173

# API Configuration
VITE_API_URL=https://api.9jacart.ng
VITE_API_BASIC_USERNAME=admin@example.com
VITE_API_BASIC_PASSWORD=admin123

# NeoCash BNPL Widget (dashboard.neocash.ng)
# Production / `vite build`: live key only
VITE_NEOCASH_PUBLIC_KEY=pk_live_xxx
# Local `npm run dev`: test key (required so localhost does not use pk_live_)
VITE_NEOCASH_PUBLIC_KEY_TEST=pk_test_xxx